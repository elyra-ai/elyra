{
  "name": "elyra",
  "version": "4.2.0-dev",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "graph": "ts-node etc/scripts/generate-make-graph.ts",
    "cy:open": "npx cypress open",
    "cy:run": "npx nyc ${CYPRESS_SPEC:+--check-coverage=false} npx cypress run",
    "cy:debug": "npx cypress run --headed",
    "eslint": "eslint . --fix",
    "eslint:check": "eslint .",
    "prettier": "prettier --ignore-path .gitignore --write \"**/*{.ts,.tsx,.js,.jsx,.css,.json}\"",
    "prettier:check": "prettier --ignore-path .gitignore --check \"**/*{.ts,.tsx,.js,.jsx,.css,.json}\"",
    "test": "npm run test:unit && npm run test:integration",
    "start": "mkdir -p build/cypress && ts-node scripts/start-test-server.ts",
    "test:integration": "server-test 'yarn start' ':9000/healthz|http-get://localhost:58888?token=test' 'yarn cy:run'",
    "test:integration:debug": "server-test 'yarn start' ':9000/healthz|http-get://localhost:58888?token=test' 'yarn cy:open'",
    "test:unit": "lerna run test --concurrency 1 --stream"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "resolutions": {
    "@jupyterlab/core-meta": "4.6.0",
    "@types/react": "^18.0.26",
    "@types/react-dom": "^18.0.9",
    "ansi-html": "^0.0.9",
    "ejs": "^3.1.9",
    "glob-parent": "^5.1.2",
    "node-forge": "^1.3.0",
    "react": "^18.2.0",
    "react-dev-utils": "^12.0.1",
    "react-dom": "^18.2.0",
    "react-intl": "^6.5.5",
    "trim-newlines": "^5.0.0",
    "yjs": "^13.5.40"
  },
  "devDependencies": {
    "@cypress/code-coverage": "^3.14.7",
    "@eslint/compat": "^1.4.1",
    "@eslint/js": "^9.39.5",
    "@glen/jest-raw-loader": "^2.0.0",
    "@testing-library/cypress": "^10.1.3",
    "@types/jest": "^29.2.0",
    "@types/lodash": "^4.14.170",
    "@types/node": "^22.10.5",
    "chalk": "^5.4.1",
    "cypress": "^14.5.4",
    "cypress-real-events": "^1.15.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-cypress": "^4.3.0",
    "eslint-plugin-header": "^3.1.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-mocha": "^11.3.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.14.0",
    "husky": "^8.0.3",
    "isomorphic-fetch": "^3.0.0",
    "jest": "^29.2.0",
    "jest-diff": "^29.7.0",
    "lerna": "^8.0.1",
    "lint-staged": "^15.2.0",
    "lodash": "^4.17.21",
    "nyc": "^17.1.0",
    "nyc-config-tsx": "^0.1.0",
    "prettier": "^3.1.1",
    "start-server-and-test": "^2.0.3",
    "ts-jest": "^29.3.2",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "webpack": "^5.76.1"
  },
  "engines": {
    "node": "^22.0.0"
  },
  "packageManager": "yarn@3.5.0"
}
